# ============================================================
#  换行与二进制标记
#
#  *.bat / *.vbs 必须是 CRLF：LF 行尾会让 cmd.exe 解析异常，
#  UTF-8 BOM 会把首行 @echo off 变成乱码（这是踩过的坑，别改）。
#  js 保持 CRLF 以与现有文件字节一致；纯文本类用 LF。
# ============================================================

*               text=auto eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.vbs           text eol=crlf
*.ps1           text eol=crlf
*.js            text eol=crlf

*.html          text eol=lf
*.css           text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.txt           text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制：禁止换行转换，也不要在 diff 里显示
*.exe           binary
*.dll           binary
*.pyd           binary
*.so            binary
*.ico           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.zip           binary
*.7z            binary
*.lnk           binary
*.mp4           binary
*.mkv           binary
*.webm          binary
*.mp3           binary
*.m4a           binary
